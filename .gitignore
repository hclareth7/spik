# Secretos — NUNCA commitear
.env

# data/ es 100% LOCAL ("todo local"): grabaciones, audio extraído, DB de sesiones,
# prefs de runtime (.ui-prefs.json/.projects.json) y la CACHÉ de modelos descargados
# (data/.cache/ — WhisperX/HuggingFace/torch, varios GB). NADA de data/ va al repo.
# Se conserva la carpeta vacía con data/.gitkeep para que exista tras clonar.
/data/*
!/data/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Modelos descargados (Whisper, etc.)
models/

# App de escritorio (Wails). El binario compilado (build/bin ya lo cubre `build/` arriba) y
# la copia suelta `desktop/spik-desktop` no se versionan; los bindings de runtime que Wails
# regenera en cada build tampoco. El icono embebido (desktop/build/appicon.*) se fuerza aparte.
/desktop/spik-desktop
/desktop/frontend/wailsjs/

# Frontend (React + Vite). El build (web/dist, frontend/dist) ya lo cubre `dist/` arriba.
# package-lock.json SÍ se commitea (reproducibilidad del build).
node_modules/
frontend/node_modules/
*.tsbuildinfo
