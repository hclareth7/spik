# Copia este archivo a .env y ajústalo. NUNCA subas .env al control de versiones.
# A Claude solo se le envía texto/métricas para el feedback; el video jamás sale de la máquina.
#
# Prefijo: las variables usan SPIK_* (nombre oficial del proyecto). Por compatibilidad, el
# código también acepta el prefijo histórico SPEAK_* si aún lo tienes en tu .env.

# --- Proveedor del modelo ---
# "vertex"    -> Google Cloud Vertex AI (recomendado en esta máquina; auth por gcloud, sin API key)
# "anthropic" -> Claude API directo (requiere ANTHROPIC_API_KEY)
SPIK_PROVIDER=vertex

# --- Vertex AI (si SPIK_PROVIDER=vertex) ---
# Autentícate una vez con:  gcloud auth application-default login
SPIK_VERTEX_PROJECT=tu-proyecto-gcp        # o define GOOGLE_CLOUD_PROJECT
SPIK_VERTEX_REGION=global                   # global (recomendado), us, eu o una región

# --- Claude API directo (solo si SPIK_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Modelo de Claude para el feedback ---
# En Vertex usa el id "pelado" y verifica cuál tienes habilitado en tu Model Garden.
# Descubre los habilitados con una llamada de prueba; en esta máquina responden:
#   claude-sonnet-4-5 (recomendado)  y  claude-haiku-4-5 (más rápido/barato).
# NOTA: la organización veta 'structured_outputs' y features avanzadas de modelos partner,
# por eso feedback.py pide el JSON por prompt (no usa output_config ni thinking).
SPIK_CLAUDE_MODEL=claude-sonnet-4-5

# --- Modelo de Whisper (transcripción, corre local en CPU) ---
# Esta máquina no tiene GPU NVIDIA -> usa "small" o "medium".
SPIK_WHISPER_MODEL=medium

# ─────────────────────────────────────────────────────────────────────────────
# Optimización para audios largos (2–3 h): troceado + transcripción concurrente.
# Todos son opcionales; los defaults son sensatos para esta máquina (20 núcleos, ~16 GB libres).
# ─────────────────────────────────────────────────────────────────────────────

# A partir de esta duración (segundos) se usa la ruta troceada concurrente en vez de single-shot.
# Default 900 (15 min). Bájalo para forzar la ruta larga en pruebas.
# SPIK_CHUNK_THRESHOLD_S=900

# Tamaño objetivo de cada trozo en segundos (el corte real cae en el silencio más cercano).
# Default 600 (10 min).
# SPIK_WHISPER_CHUNK_S=600

# Nº de procesos worker paralelos. 0 = auto (según núcleos y RAM disponible, ~3 GB/worker, tope 6).
# Súbelo con cuidado: cada worker carga su propio modelo (~3 GB de RAM).
# SPIK_WHISPER_WORKERS=0

# batch_size que se pasa a WhisperX (afecta velocidad/uso de memoria por proceso). Default 8.
# SPIK_WHISPER_BATCH_SIZE=8

# ─────────────────────────────────────────────────────────────────────────────
# Análisis no verbal (Fase 3): gestos, expresión facial, postura y proxy de contacto visual.
# Corre 100% local en CPU con MediaPipe. Requiere el extra:  pip install -e ".[vision]"
# Si falta el extra o falla, el análisis sigue con solo métricas verbales (degradación grácil).
# ─────────────────────────────────────────────────────────────────────────────

# Activa/desactiva el análisis no verbal. Default: 1 (activo). Ponlo en 0 para saltarlo.
# SPIK_VISION=1

# Frames por segundo a MUESTREAR para visión (el video se submuestrea). Default 5.
# SPIK_VISION_FPS=5

# Reduce el lado más largo de cada frame muestreado a estos píxeles antes de detectar. Default 640.
# SPIK_VISION_MAX_DIM=640

# Directorio con los modelos MediaPipe .task pinneados (instalaciones offline). Si no se define,
# se descargan una vez a data/.cache/mediapipe/ (URLs públicas de Google Storage).
# SPIK_VISION_MODEL_DIR=/ruta/a/modelos

# ─────────────────────────────────────────────────────────────────────────────
# Despliegue / modo de ejecución
# ─────────────────────────────────────────────────────────────────────────────

# "local"     -> app del host: todo (captura + análisis + filtro de ruido), escucha en 127.0.0.1 (default).
# "server"    -> contenedor detrás de Traefik: solo Analizar/Feedback/Historial (sin cámara/micro).
# "appliance" -> contenedor privilegiado para COMPARTIR con amigos: captura + grabar + análisis + feedback,
#                todo dentro del contenedor, PERO sin el filtro de ruido en vivo (no hay systemctl --user
#                allí). Lo fija deploy/docker-compose.share.yaml; no hace falta ponerlo a mano.
# SPIK_MODE=local

# --- Compartir spik con amigos (modo appliance) ---
# El compose deploy/docker-compose.share.yaml usa SPIK_PROVIDER=anthropic para que cada amigo pague
# su propio feedback con SU clave. Basta con poner arriba:
#     SPIK_PROVIDER=anthropic
#     ANTHROPIC_API_KEY=sk-ant-...
# Sin clave, el contenedor corre solo métricas locales (transcripción + WPM/muletillas/pausas, $0).
# Detalles: deploy/README.md -> "Compartir con amigos (modo appliance)".

# Directorio de datos (grabaciones + SQLite). Default: <repo>/data. El contenedor usa /data.
# SPIK_DATA_DIR=/ruta/a/data
